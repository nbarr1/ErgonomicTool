# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Markdown uses two trailing spaces for hard line breaks; Prettier handles wrapping.
trim_trailing_whitespace = false
max_line_length = off

[docs/build-prompt.md]
# The governing specification is stored unedited.
insert_final_newline = unset
trim_trailing_whitespace = unset

[*.csv]
trim_trailing_whitespace = false
